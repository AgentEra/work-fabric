{
  "name": "@work-fabric/core-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:github-provider": "tsc --noEmit -p examples/github-capability-provider/tsconfig.json",
    "conformance": "tsx tools/conformance/src/cli.ts",
    "postgres:migrate": "tsx tools/postgres-migrate.ts",
    "postgres:smoke": "tsx tools/postgres-smoke.ts",
    "sqlite:migrate": "tsx tools/sqlite-migrate.ts",
    "service:start": "tsx packages/service-node/src/main.ts",
    "agent-runtime:provision": "tsx examples/agently-agent-runtime/src/provision.ts",
    "agent-runtime:start": "tsx examples/agently-agent-runtime/src/main.ts",
    "feishu-provider:provision": "tsx examples/feishu-capability-provider/src/provision.ts",
    "feishu-provider:start": "tsx examples/feishu-capability-provider/src/main.ts",
    "github-provider:provision": "tsx examples/github-capability-provider/src/provision.ts",
    "github-provider:start": "tsx examples/github-capability-provider/src/main.ts",
    "feishu-calendar:admin": "tsx tools/feishu-calendar-admin.ts",
    "local:feishu:provision": "tsx tools/local-feishu-provision.ts",
    "local:feishu:start": "tsx tools/local-feishu-stack.ts",
    "local:github:start": "tsx tools/local-github-provider.ts",
    "local:feishu:status": "tsx tools/local-feishu-status.ts",
    "local:debug:start": "tsx tools/local-debug-stack.ts",
    "local:debug:status": "tsx tools/local-debug-status.ts",
    "local:debug:send": "tsx tools/local-debug-send.ts",
    "local:debug:stop": "tsx tools/local-debug-stack.ts --stop",
    "local:debug:e2e": "vitest run packages/service-node/test/debug-channel.e2e.test.ts",
    "agent-runtime:test-python": "uv run --project runtimes/agently-worker pytest -q",
    "verify:agent-runtime": "npm run typecheck && vitest run packages/agent-runtime-spi/test packages/adapter-agent-runtime-memory/test packages/adapter-agent-runtime-sqlite/test packages/adapter-authority-agent-runtime/test packages/agent-runtime-host/test packages/adapter-agent-runtime-agently/test examples/agently-agent-runtime/test && uv run --project runtimes/agently-worker pytest -q && npm run conformance",
    "console:dev": "npm --workspace @work-fabric/console-web run dev",
    "console:build": "npm --workspace @work-fabric/console-web run build",
    "benchmark:operability": "tsx tools/benchmark-operability.ts",
    "benchmark:cluster": "tsx tools/benchmark-cluster-runtime.ts",
    "nats:wakeup-topology": "tsx tools/nats-wakeup-topology.ts",
    "verify:nats": "npm run typecheck && vitest run packages/adapter-cluster-nats/test tools/nats-wakeup-topology.test.ts tools/nats-server-release.test.ts tools/benchmark-nats-wakeup.test.ts",
    "nats:release": "tsx tools/nats-server-release.ts --",
    "verify:nats:release": "npm run nats:release -- npm run verify:nats",
    "benchmark:wakeup": "tsx tools/benchmark-nats-wakeup.ts",
    "benchmark:discovery": "tsx tools/benchmark-discovery.ts",
    "check:console-boundaries": "tsx tools/check-console-boundaries.ts",
    "check:cluster-boundaries": "tsx tools/check-cluster-boundaries.ts",
    "check:federation-boundaries": "tsx tools/check-federation-boundaries.ts",
    "check:plugin-boundaries": "tsx tools/check-plugin-boundaries.ts",
    "check:admission-boundaries": "tsx tools/check-admission-boundaries.ts",
    "check:discovery-boundaries": "tsx tools/check-discovery-boundaries.ts",
    "check:sensitive-observability": "tsx tools/check-sensitive-observability.ts",
    "verify:postgres": "npm run typecheck && vitest run packages/adapter-postgres-common/test packages/adapter-storage-postgres/test packages/adapter-context-postgres/test && npm run conformance",
    "verify": "npm run typecheck && npm test && npm run conformance",
    "verify:exchange": "npm run typecheck && vitest run packages && npm run conformance"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
