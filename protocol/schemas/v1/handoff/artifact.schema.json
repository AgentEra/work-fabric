{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:artifact",
  "title": "Result Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "resource"],
  "properties": {
    "artifact_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 128
    },
    "resource": {
      "$ref": "urn:work-fabric:schema:v1:resource-ref"
    },
    "extensions": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/extensions"
    }
  }
}
