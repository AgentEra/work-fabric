{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:handoff-snapshot",
  "title": "Handoff Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "thread_id",
    "resource_version",
    "lifecycle_state",
    "current_responsible_actor",
    "target_binding",
    "package",
    "latest_status",
    "result",
    "parent_handoff_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "handoff_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "thread_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "resource_version": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/resource_version"
    },
    "lifecycle_state": {
      "enum": [
        "target_resolution_pending",
        "target_unavailable",
        "offered",
        "accepted",
        "result_returned",
        "verified",
        "rework_requested",
        "closed",
        "declined",
        "expired",
        "cancelled",
        "transferred"
      ]
    },
    "current_responsible_actor": {
      "oneOf": [
        { "$ref": "urn:work-fabric:schema:v1:actor-ref" },
        { "type": "null" }
      ]
    },
    "target_binding": {
      "oneOf": [
        { "$ref": "#/$defs/target_binding" },
        { "type": "null" }
      ]
    },
    "package": {
      "$ref": "#/$defs/handoff_package"
    },
    "latest_status": {
      "oneOf": [
        { "$ref": "urn:work-fabric:schema:v1:status-update" },
        { "type": "null" }
      ]
    },
    "result": {
      "oneOf": [
        { "$ref": "urn:work-fabric:schema:v1:result-submission" },
        { "type": "null" }
      ]
    },
    "parent_handoff_id": {
      "oneOf": [
        {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
        },
        { "type": "null" }
      ]
    },
    "created_at": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/extensions"
    }
  },
  "$defs": {
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "resolved_by",
        "resolver_endpoint_id",
        "delegation_id",
        "resolved_at",
        "evidence"
      ],
      "properties": {
        "target": {
          "$ref": "urn:work-fabric:schema:v1:handoff-explicit-target"
        },
        "resolved_by": {
          "$ref": "urn:work-fabric:schema:v1:actor-ref"
        },
        "resolver_endpoint_id": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
        },
        "delegation_id": {
          "oneOf": [
            {
              "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
            },
            { "type": "null" }
          ]
        },
        "resolved_at": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:work-fabric:schema:v1:evidence"
          }
        }
      }
    },
    "handoff_package": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "context_bundle_id": { "type": "null" },
            "context_bundle_version": { "type": "null" }
          }
        },
        {
          "properties": {
            "context_bundle_id": {
              "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
            },
            "context_bundle_version": {
              "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/resource_version"
            }
          }
        }
      ],
      "required": [
        "work_reference",
        "target",
        "intent",
        "context_bundle_id",
        "context_bundle_version",
        "authority_scope_id",
        "acceptance_criteria_ids",
        "verifier_actor_id",
        "accept_by",
        "result_due_at"
      ],
      "properties": {
        "work_reference": {
          "$ref": "urn:work-fabric:schema:v1:resource-ref"
        },
        "target": {
          "$ref": "urn:work-fabric:schema:v1:handoff-target"
        },
        "intent": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:work-fabric:schema:v1:content-part"
          }
        },
        "context_bundle_id": {
          "oneOf": [
            {
              "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
            },
            { "type": "null" }
          ]
        },
        "context_bundle_version": {
          "oneOf": [
            {
              "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/resource_version"
            },
            { "type": "null" }
          ]
        },
        "authority_scope_id": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
        },
        "acceptance_criteria_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
          }
        },
        "verifier_actor_id": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
        },
        "accept_by": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
        },
        "result_due_at": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
        }
      }
    }
  }
}
