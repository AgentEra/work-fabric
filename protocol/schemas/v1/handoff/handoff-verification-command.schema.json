{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:handoff-verification-command",
  "title": "Handoff Verification Command Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "satisfied_criterion_ids",
    "summary",
    "evidence"
  ],
  "properties": {
    "handoff_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "satisfied_criterion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
      }
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:content-part"
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:evidence"
      }
    },
    "extensions": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/extensions"
    }
  }
}
