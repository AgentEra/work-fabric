{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:evidence",
  "title": "Result Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "evidence_type", "content"],
  "properties": {
    "evidence_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "evidence_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 128
    },
    "content": {
      "$ref": "urn:work-fabric:schema:v1:content-part"
    },
    "extensions": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/extensions"
    }
  }
}
