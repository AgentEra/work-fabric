{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:trace-context",
  "title": "Trace Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["traceparent"],
  "properties": {
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
