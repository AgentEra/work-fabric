{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:event-delivery",
  "title": "At-Least-Once Event Delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_id",
    "subscription_id",
    "attempt",
    "events",
    "next_cursor",
    "delivered_at",
    "visibility_expires_at"
  ],
  "properties": {
    "delivery_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "subscription_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:protocol-event"
      }
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "delivered_at": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
    },
    "visibility_expires_at": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/extensions"
    }
  }
}
