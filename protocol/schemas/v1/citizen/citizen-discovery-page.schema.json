{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:citizen-discovery-page",
  "title": "Network Citizen Discovery Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:citizen-descriptor"
      }
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
