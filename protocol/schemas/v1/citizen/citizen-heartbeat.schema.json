{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:citizen-heartbeat",
  "title": "Network Citizen Heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fencing_token",
    "heartbeat_sequence",
    "availability",
    "expected_registration_version"
  ],
  "properties": {
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "heartbeat_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "availability": {
      "$ref": "urn:work-fabric:schema:v1:citizen-descriptor#/$defs/availability"
    },
    "expected_registration_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
