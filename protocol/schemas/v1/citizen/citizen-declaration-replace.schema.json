{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:citizen-declaration-replace",
  "title": "Network Citizen Declaration Replacement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fencing_token",
    "expected_registration_version",
    "expected_declaration_version",
    "declarations"
  ],
  "properties": {
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "expected_registration_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_declaration_version": {
      "type": "integer",
      "minimum": 1
    },
    "declarations": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:citizen-declaration"
      }
    }
  }
}
