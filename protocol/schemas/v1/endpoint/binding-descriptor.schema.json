{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:binding-descriptor",
  "title": "Binding Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_type", "uri", "security_schemes"],
  "properties": {
    "binding_type": {
      "oneOf": [
        {
          "enum": ["http_sse", "webhook", "local_process", "a2a", "mcp"]
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z][a-z0-9_]*$"
        }
      ]
    },
    "uri": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/absolute_uri"
    },
    "security_schemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 128
      }
    },
    "extensions": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/extensions"
    }
  }
}
