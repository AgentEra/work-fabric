{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:endpoint-identity-card",
  "title": "Endpoint Identity Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint_id",
    "actor",
    "endpoint_type",
    "display_name",
    "protocol_versions",
    "availability",
    "lease"
  ],
  "properties": {
    "endpoint_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "actor": {
      "$ref": "urn:work-fabric:schema:v1:actor-ref"
    },
    "endpoint_type": {
      "oneOf": [
        {
          "enum": ["human_adapter", "native_agent", "system_connector"]
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z][a-z0-9_]*$"
        }
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "availability": {
      "enum": ["available", "busy", "draining", "unavailable"]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at", "renew_after"],
      "properties": {
        "expires_at": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
        },
        "renew_after": {
          "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
        }
      }
    }
  }
}
