{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:endpoint-session",
  "title": "Endpoint Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint_id",
    "actor",
    "session_id",
    "client_session_id",
    "protocol_version",
    "capabilities",
    "availability",
    "accepted_lease_seconds",
    "fencing_token",
    "heartbeat_sequence",
    "state",
    "expires_at",
    "renew_after",
    "registration_version"
  ],
  "properties": {
    "endpoint_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "actor": {
      "$ref": "urn:work-fabric:schema:v1:actor-ref"
    },
    "session_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "client_session_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:capability-descriptor"
      }
    },
    "availability": {
      "enum": ["available", "busy", "draining", "unavailable"]
    },
    "accepted_lease_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "heartbeat_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": ["active", "closed", "fenced"]
    },
    "expires_at": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
    },
    "renew_after": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/timestamp"
    },
    "registration_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
