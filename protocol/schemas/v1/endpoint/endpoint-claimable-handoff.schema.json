{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:endpoint-claimable-handoff",
  "title": "Endpoint Claimable Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partition_id",
    "handoff_id",
    "resource_version",
    "lifecycle_state",
    "capability_ids",
    "last_event_id",
    "observed_position"
  ],
  "properties": {
    "partition_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "handoff_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "resource_version": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/resource_version"
    },
    "lifecycle_state": {
      "const": "claimable"
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
        "maxLength": 128
      }
    },
    "last_event_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "observed_position": {
      "type": "integer",
      "minimum": 1
    }
  }
}
