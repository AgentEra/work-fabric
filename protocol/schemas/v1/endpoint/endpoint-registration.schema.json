{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:endpoint-registration",
  "title": "Endpoint Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint_id",
    "actor",
    "endpoint_type",
    "display_name",
    "protocol_versions",
    "bindings",
    "allowed_capability_ids",
    "limits",
    "administrative_state",
    "registration_version"
  ],
  "properties": {
    "endpoint_id": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/opaque_id"
    },
    "actor": {
      "$ref": "urn:work-fabric:schema:v1:actor-ref"
    },
    "endpoint_type": {
      "$ref": "urn:work-fabric:schema:v1:endpoint-descriptor#/properties/endpoint_type"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$",
        "maxLength": 32
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:binding-descriptor"
      }
    },
    "allowed_capability_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
        "maxLength": 128
      }
    },
    "limits": {
      "$ref": "urn:work-fabric:schema:v1:endpoint-descriptor#/properties/limits"
    },
    "administrative_state": {
      "enum": ["enabled", "disabled"]
    },
    "registration_version": {
      "type": "integer",
      "minimum": 1
    },
    "extensions": {
      "$ref": "urn:work-fabric:schema:v1:definitions#/$defs/extensions"
    }
  }
}
