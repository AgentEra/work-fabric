{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work-fabric:schema:v1:endpoint-heartbeat",
  "title": "Endpoint Heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fencing_token",
    "heartbeat_sequence",
    "availability",
    "capabilities",
    "expected_registration_version"
  ],
  "properties": {
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "heartbeat_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "availability": {
      "enum": ["available", "busy", "draining", "unavailable"]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:work-fabric:schema:v1:capability-descriptor"
      }
    },
    "expected_registration_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
